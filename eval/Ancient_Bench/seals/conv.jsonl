{"image": "seals_000250.png", "human_gt": "張\n世印"}
{"image": "seals_000251.png", "human_gt": "吉無\n不利"}
{"image": "seals_000252.png", "human_gt": "達作寶敦\n其萬年子\n孫永寶用"}
{"image": "seals_000253.png", "human_gt": "一切皆\n至誠"}
{"image": "seals_000254.png", "human_gt": "只應\n天也知\n人意"}
{"image": "seals_000255.png", "human_gt": "希高\n慕古"}
{"image": "seals_000256.png", "human_gt": "二酉山房"}
{"image": "seals_000257.png", "human_gt": "匏臥\n室"}
{"image": "seals_000258.png", "human_gt": "不敏"}
{"image": "seals_000259.png", "human_gt": "東岳泰山\n北岳恆山\n中岳嵩山\n西岳華山\n南岳衡山"}
{"image": "seals_000260.png", "human_gt": "天地一壺中笑造\n化小兒搬弄"}
{"image": "seals_000261.png", "human_gt": "春鳥\n報\n平安"}
{"image": "seals_000262.png", "human_gt": "翁歸"}
{"image": "seals_000263.png", "human_gt": "居今\n稽古"}
{"image": "seals_000264.png", "human_gt": "三寸枯\n毫欲\n燒未忍"}
{"image": "seals_000265.png", "human_gt": "退齋\n居士"}
{"image": "seals_000266.png", "human_gt": "人能生\n事=煩則\n害其命"}
{"image": "seals_000267.png", "human_gt": "史\n敖力"}
{"image": "seals_000268.png", "human_gt": "祝壽"}
{"image": "seals_000269.png", "human_gt": "且提\n壺花\n間竹下"}
{"image": "seals_000270.png", "human_gt": "畫棟朝飛南浦雲"}
{"image": "seals_000271.png", "human_gt": "煮\n茗就\n花闌"}
{"image": "seals_000272.png", "human_gt": "關麟\n徵印"}
{"image": "seals_000273.png", "human_gt": "渺=兮\n余懷"}
{"image": "seals_000274.png", "human_gt": "身心\n泰然"}
{"image": "seals_000275.png", "human_gt": "巨鹿\n太守\n章"}
{"image": "seals_000276.png", "human_gt": "明月夜窓虛"}
{"image": "seals_000277.png", "human_gt": "好山\n好水是\n吾家"}
{"image": "seals_000278.png", "human_gt": "服之\n獲\n上壽"}
{"image": "seals_000279.png", "human_gt": "行延\n以\n氣壽"}
{"image": "seals_000280.png", "human_gt": "廣州"}
{"image": "seals_000281.png", "human_gt": "餐松\n餌术\n棲息\n烟霞"}
{"image": "seals_000282.png", "human_gt": "耕於寬閒\n之野釣於\n寂寞之濱"}
{"image": "seals_000283.png", "human_gt": "西明\n私\n識李"}
{"image": "seals_000284.png", "human_gt": "天倉開"}
{"image": "seals_000285.png", "human_gt": "其狂\n不可及"}
{"image": "seals_000286.png", "human_gt": "玉杵\n秋空"}
{"image": "seals_000287.png", "human_gt": "鶴栖\n居主人人"}
{"image": "seals_000288.png", "human_gt": "春夏\n讀書\n秋冬\n射獵"}
{"image": "seals_000289.png", "human_gt": "忍之一\n事衆\n妙之門"}
{"image": "seals_000290.png", "human_gt": "不墜\n青雲\n之志"}
{"image": "seals_000291.png", "human_gt": "樓中\n飲興\n因明月"}
{"image": "seals_000292.png", "human_gt": "勿唆\n人之\n爭訟"}
{"image": "seals_000293.png", "human_gt": "山猿悲\n嘯谷\n泉響"}
{"image": "seals_000294.png", "human_gt": "寄身於\n翰墨\n見志於\n篇籍"}
{"image": "seals_000295.png", "human_gt": "采菱渡頭風急策杖林西日斜\n杏樹壇邊漁父桃花源裏人家"}
{"image": "seals_000296.png", "human_gt": "結茅\n屋於\n雲邉"}
{"image": "seals_000297.png", "human_gt": "時仗\n濁醪\n一澆\n磊塊"}
{"image": "seals_000298.png", "human_gt": "乾坤清\n氣得來難"}
{"image": "seals_000299.png", "human_gt": "石赤不\n奪節\n士之必"}
{"image": "seals_000300.png", "human_gt": "十畝之宅五\n畝之園有水\n一池有竹千竿"}
{"image": "seals_000301.png", "human_gt": "阮嗣宗口\n不論人過\n吾每師之\n而未能及"}
{"image": "seals_000302.png", "human_gt": "故名不\n出於家"}
{"image": "seals_000303.png", "human_gt": "壽觴舉"}
{"image": "seals_000304.png", "human_gt": "寬泰\n自居\n恬寞\n自守"}
{"image": "seals_000305.png", "human_gt": "商遺"}
{"image": "seals_000306.png", "human_gt": "金尊\n瑤管共\n綢繆"}
{"image": "seals_000307.png", "human_gt": "風前\n歌嘯月\n下高眠"}
{"image": "seals_000308.png", "human_gt": "超=神\n明返\n冥無"}
{"image": "seals_000309.png", "human_gt": "參之太史\n以著其潔"}
{"image": "seals_000310.png", "human_gt": "追思\n往事\n好沾巾"}
{"image": "seals_000311.png", "human_gt": "隨\n時愛\n景光"}
{"image": "seals_000312.png", "human_gt": "真奇怪"}
{"image": "seals_000313.png", "human_gt": "惟五月庚申\n叔液自作餴\n鼎用祈眉壽\n萬年無疆\n永壽用之"}
{"image": "seals_000314.png", "human_gt": "內山\n外川"}
{"image": "seals_000315.png", "human_gt": "修身者志之符\n也愛施者仁之端也\n取與者義之表\n也恥辱者勇之決\n也立名者行之極也"}
{"image": "seals_000316.png", "human_gt": "不有佳作"}
{"image": "seals_000317.png", "human_gt": "長年"}
{"image": "seals_000318.png", "human_gt": "所守者\n道義所\n行者忠信"}
{"image": "seals_000319.png", "human_gt": "一邱一壑\n也風流"}
{"image": "seals_000320.png", "human_gt": "以照\n人行"}
{"image": "seals_000321.jpg", "human_gt": "二十舉鄉三十\n登第四十還\n朝五十出守六十\n開府七十歸田"}
{"image": "seals_000322.jpg", "human_gt": "奉化張氏奕辰字\n奠酉別署百篆\n樓珍藏金石書\n畫文字圖籍之印"}
{"image": "seals_000323.jpg", "human_gt": "先天下之\n憂而憂\n後天下之\n樂而樂"}
{"image": "seals_000324.jpg", "human_gt": "伍元蕙儷荃甫\n評書讀畫之印"}
{"image": "seals_000325.jpg", "human_gt": "心清自得詩\n書味室雅時\n聞翰墨香"}
{"image": "seals_000326.jpg", "human_gt": "白日蒼苔\n塵外相心\n清風明月\n醉時-歌"}
{"image": "seals_000327.jpg", "human_gt": "納涼小艇穿\n花過指點\n蘇堤第一橋"}
{"image": "seals_000328.jpg", "human_gt": "羅浮觀海崑\n崙尋河原身\n行萬里半天下"}
{"image": "seals_000329.jpg", "human_gt": "苟非吾之\n所有雖一\n毫而莫取"}
{"image": "seals_000330.jpg", "human_gt": "空山新雨後天氣晚\n來秋明月松間照清泉\n石上流竹喧歸浣女蓮\n動下漁舟隨意\n春芳歇王孫自可留"}
{"image": "seals_000331.jpg", "human_gt": "願得黃金\n三百萬交盡\n美人名士更結\n盡燕邯俠子"}
{"image": "seals_000332.jpg", "human_gt": "孤光自照肝\n膽皆冰雪"}
{"image": "seals_000333.jpg", "human_gt": "若不爲無\n益之事何\n以悅有涯\n之生堅記"}
{"image": "seals_000334.jpg", "human_gt": "白社會中嘗共醉\n青雲路上未相逢\n時人莫小池中水淺\n處無妨有臥龍"}
{"image": "seals_000335.jpg", "human_gt": "天行健君子以\n自強不息地\n勢坤君子以\n厚德載物"}
{"image": "seals_000336.jpg", "human_gt": "古堇周氏雪庵\n收藏舊拓善本"}
{"image": "seals_000337.jpg", "human_gt": "合肥李氏\n集虛草堂\n藏書印"}
{"image": "seals_000338.jpg", "human_gt": "吳縣潘\n伯寅平\n生真賞"}
{"image": "seals_000339.jpg", "human_gt": "花延年\n室收藏\n校訂印"}
{"image": "seals_000340.jpg", "human_gt": "貴池劉世珩\n江寧傅春媄\n江寧傅春姍\n宜春堂鑑賞"}
{"image": "seals_000341.jpg", "human_gt": "海上生\n明月天涯\n共此時"}
{"image": "seals_000342.jpg", "human_gt": "空山新雨後天氣晚\n來秋明月松間照清泉\n石上流竹喧歸浣女蓮\n動下漁舟隨意春芳歇\n王孫自可留"}
{"image": "seals_000343.jpg", "human_gt": "各見十種一切\n寶香衆眇\n華樓閣雲"}
{"image": "seals_000344.jpg", "human_gt": "願新春以\n後吉吉利=百\n事都如意"}
{"image": "seals_000345.jpg", "human_gt": "正枕當\n星劍收書\n動玉琴"}
{"image": "seals_000346.jpg", "human_gt": "吾畫遍\n行天下僞\n造居多"}
{"image": "seals_000347.jpg", "human_gt": "錫山華\n人德周甲\n後所作"}
{"image": "seals_000348.jpg", "human_gt": "五車書萬\n里路三尺\n劍一張琴"}
{"image": "seals_000349.jpg", "human_gt": "門無剝啄\n松影參\n差禽聲上\n下午睡初足"}
{"image": "seals_000350.jpg", "human_gt": "閒臨\n右軍帖\n靜讀工\n部詩"}
